@model UniDesk.Web.Models.Ticket
@using UniDesk.Web.Models

@{
    var statusClass = Model.Status switch
    {
        TicketStatus.New => "text-bg-primary",
        TicketStatus.InProgress => "text-bg-warning",
        TicketStatus.Closed => "text-bg-success",
        _ => "text-bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Szczegoly zgloszenia</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Powrot do listy</a>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<dl class="row mb-4">
    <dt class="col-sm-3">Tytul</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Opis</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        <span class="badge @statusClass">@Model.Status</span>
    </dd>

    <dt class="col-sm-3">Data utworzenia</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

    <dt class="col-sm-3">Ostatnia zmiana</dt>
    <dd class="col-sm-9">@(Model.UpdatedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
</dl>

<form asp-action="UpdateStatus" method="post" class="row g-2 align-items-end">
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="col-sm-4">
        <label class="form-label" for="status">Zmien status</label>
        <select class="form-select" id="status" name="status">
            <option value="New" selected="@(Model.Status == TicketStatus.New ? "selected" : null)">New</option>
            <option value="InProgress" selected="@(Model.Status == TicketStatus.InProgress ? "selected" : null)">InProgress</option>
            <option value="Closed" selected="@(Model.Status == TicketStatus.Closed ? "selected" : null)">Closed</option>
        </select>
        <span class="text-danger" data-valmsg-for="Status"></span>
    </div>

    <div class="col-sm-3">
        <button class="btn btn-secondary w-100" type="submit">Zapisz status</button>
    </div>
</form>

@if (User.IsInRole(UniDesk.Web.Services.IdentitySeedData.AdminRole))
{
    <form asp-action="Delete" method="post" class="mt-4"
          onsubmit="return confirm('Czy na pewno chcesz usunac to zgloszenie?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="btn btn-danger">
            Usun zgloszenie
        </button>
    </form>
}
