@model IEnumerable<UniDesk.Web.Models.Ticket>
@using UniDesk.Web.Models

@{
    var status = Context.Request.Query["status"].ToString();
    var search = Context.Request.Query["search"].ToString();
    var sortBy = Context.Request.Query["sortBy"].ToString();
    var sortDirection = Context.Request.Query["sortDirection"].ToString();

    int currentPage;
    int.TryParse(Context.Request.Query["page"], out currentPage);
    if (currentPage < 1)
    {
        currentPage = 1;
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Lista zgloszen</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Create">Dodaj zgloszenie</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-3">
        <label class="form-label" for="status">Status</label>
        <select class="form-select" id="status" name="status">
            <option value="">Wszystkie</option>
            <option value="New" selected="@(status == "New" ? "selected" : null)">New</option>
            <option value="InProgress" selected="@(status == "InProgress" ? "selected" : null)">InProgress</option>
            <option value="Closed" selected="@(status == "Closed" ? "selected" : null)">Closed</option>
        </select>
    </div>
    <div class="col-md-5">
        <label class="form-label" for="search">Tytul</label>
        <input class="form-control" id="search" name="search" value="@search" placeholder="Szukaj po tytule" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-secondary w-100" type="submit">Szukaj</button>
    </div>
    <div class="col-md-2">
        <a class="btn btn-outline-secondary w-100" asp-action="Index">Wyczysc</a>
    </div>
</form>

<table class="table table-bordered table-sm align-middle">
    <thead>
        <tr>
            <th>
                <a asp-action="Index"
                   asp-route-status="@status"
                   asp-route-search="@search"
                   asp-route-sortBy="Title"
                   asp-route-sortDirection="@(sortBy == "Title" && sortDirection != "desc" ? "desc" : "asc")">
                    Tytul
                </a>
            </th>
            <th>Opis</th>
            <th>
                <a asp-action="Index"
                   asp-route-status="@status"
                   asp-route-search="@search"
                   asp-route-sortBy="Status"
                   asp-route-sortDirection="@(sortBy == "Status" && sortDirection != "desc" ? "desc" : "asc")">
                    Status
                </a>
            </th>
            <th>
                <a asp-action="Index"
                   asp-route-status="@status"
                   asp-route-search="@search"
                   asp-route-sortBy="CreatedAt"
                   asp-route-sortDirection="@(sortBy == "CreatedAt" && sortDirection != "desc" ? "desc" : "asc")">
                    Data utworzenia
                </a>
            </th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center py-3">Brak zgloszen dla wybranych filtrow.</td>
            </tr>
        }
        else
        {
            foreach (var ticket in Model)
            {
                <tr>
                    <td>@ticket.Title</td>
                    <td>@ticket.Description</td>
                    <td>@ticket.Status</td>
                    <td>@ticket.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@ticket.Id">Szczegoly</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<nav aria-label="Stronicowanie zgloszen">
    <ul class="pagination pagination-sm">
        @if (currentPage > 1)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-status="@status"
                   asp-route-search="@search"
                   asp-route-sortBy="@sortBy"
                   asp-route-sortDirection="@sortDirection"
                   asp-route-page="@(currentPage - 1)">
                    Poprzednia
                </a>
            </li>
        }

        <li class="page-item active" aria-current="page">
            <span class="page-link">@currentPage</span>
        </li>

        @if (Model.Count() >= 10)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-status="@status"
                   asp-route-search="@search"
                   asp-route-sortBy="@sortBy"
                   asp-route-sortDirection="@sortDirection"
                   asp-route-page="@(currentPage + 1)">
                    Nastepna
                </a>
            </li>
        }
    </ul>
</nav>
